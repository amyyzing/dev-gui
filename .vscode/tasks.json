    {
      "label": "Luau: Compile QB Aim Logic",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\luau\\luau-compile.exe",
      "args": [
        "${workspaceFolder}\\features\\qb-aim\\logic.lua"
      ],
      "problemMatcher": []
    }
  ]
}

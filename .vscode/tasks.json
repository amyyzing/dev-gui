{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Luau: Compile Active File",
      "type": "process",
      "command": "${workspaceFolder}\\.tools\\luau\\luau-compile.exe",
      "args": [
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
